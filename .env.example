# ─────────────────────────────────────────────────────────
# Copy this file to  server/.env  and fill in your values.
# Never commit server/.env to git.
# ─────────────────────────────────────────────────────────

# MongoDB Atlas connection string
# Get it from: Atlas dashboard → Connect → Drivers → Node.js
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/grace-house?retryWrites=true&w=majority

# Port the Express API listens on
PORT=5000

# The URL of your React frontend (for CORS)
CLIENT_ORIGIN=http://localhost:5173
