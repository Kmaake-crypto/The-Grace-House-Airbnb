{
  "name": "grace-house-airbnb",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo root — client/ (React/Vite) + server/ (Express/MongoDB)",
  "scripts": {
    "dev":          "concurrently --names \"CLIENT,SERVER\" --prefix-colors \"cyan,green\" \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client":   "vite --config client/vite.config.js",
    "dev:server":   "nodemon server/index.js",
    "build":        "vite build --config client/vite.config.js",
    "preview":      "vite preview --config client/vite.config.js",
    "start:server": "node server/index.js",
    "lint":         "eslint client/src"
  },
  "dependencies": {
    "cors":             "^2.8.6",
    "dotenv":           "^17.4.2",
    "express":          "^5.2.1",
    "jsonwebtoken":     "^9.0.3",
    "mongoose":         "^9.9.4",
    "react":            "^19.2.8",
    "react-dom":        "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js":                 "^10.0.1",
    "@types/react":               "^19.2.18",
    "@types/react-dom":           "^19.2.4",
    "@vitejs/plugin-react":       "^6.1.0",
    "autoprefixer":               "^10.5.4",
    "concurrently":               "^10.0.5",
    "eslint":                     "^10.9.0",
    "eslint-plugin-react-hooks":  "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals":                    "^17.11.0",
    "nodemon":                    "^3.1.14",
    "postcss":                    "^8.5.26",
    "tailwindcss":                "^3.4.17",
    "vite":                       "^8.2.2"
  }
}
